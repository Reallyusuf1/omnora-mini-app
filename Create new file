<!DOCTYPE html>
<html>
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Omnora Mini App</title>
  <script src="https://telegram.org/js/telegram-web-app.js"></script>
  <style>
    * { margin: 0; padding: 0; box-sizing: border-box; }
    body {
      font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif;
      background: var(--tg-theme-bg-color, #ffffff);
      color: var(--tg-theme-text-color, #000000);
      display: flex;
      justify-content: center;
      align-items: center;
      height: 100vh;
      flex-direction: column;
      padding: 20px;
    }
    .container {
      text-align: center;
      max-width: 400px;
    }
    h1 {
      font-size: 28px;
      margin-bottom: 10px;
      color: var(--tg-theme-text-color, #000);
    }
    p {
      font-size: 16px;
      margin-bottom: 30px;
      color: var(--tg-theme-hint-color, #666);
    }
    button {
      background: var(--tg-theme-button-color, #0088cc);
      color: var(--tg-theme-button-text-color, #ffffff);
      border: none;
      padding: 15px 40px;
      border-radius: 12px;
      font-size: 18px;
      font-weight: 600;
      cursor: pointer;
      transition: opacity 0.2s;
      margin: 8px;
      width: 200px;
    }
    button:hover { opacity: 0.9; }
    button:active { transform: scale(0.97); }
    .close-btn {
      background: var(--tg-theme-destructive-text-color, #ff3b30);
    }
  </style>
</head>
<body>
  <div class="container">
    <h1>🚀 Omnora</h1>
    <p>Your AI-powered Mini App</p>
    <button id="actionBtn">Click Me</button>
    <button class="close-btn" id="closeBtn">Close</button>
  </div>

  <script>
    const tg = window.Telegram.WebApp;
    tg.ready(); // Tell Telegram we're ready
    
    // Expand to full screen
    tg.expand();

    // Action button
    document.getElementById('actionBtn').onclick = function() {
      tg.showAlert('🎉 Hello from Omnora!');
      tg.sendData('User clicked the action button');
    };

    // Close button
    document.getElementById('closeBtn').onclick = function() {
      tg.close();
    };
  </script>
</body>
</html>
